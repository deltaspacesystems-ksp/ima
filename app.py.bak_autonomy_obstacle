csi_camera = None
csi_camera_lock = threading.Lock()
csi_camera_started = False


def csi_env_int(name, default):
    try:
        return int(os.getenv(name, str(default)))
    except Exception:
        return int(default)


def init_csi_camera():
    global csi_camera, csi_camera_started

    with csi_camera_lock:
        if csi_camera_started and csi_camera is not None:
            return csi_camera

        try:
            from dotenv import load_dotenv
            load_dotenv("/opt/robot/.env")
        except Exception:
            pass

        from picamera2 import Picamera2

        camera_index = csi_env_int("CSI_CAMERA_INDEX", 0)
        width = csi_env_int("CSI_CAMERA_WIDTH", 640)
        height = csi_env_int("CSI_CAMERA_HEIGHT", 360)
        fps = csi_env_int("CSI_CAMERA_FPS", 15)

        print(f"[CSI CAMERA] Starting camera index={camera_index}, {width}x{height}@{fps}")

        csi_camera = Picamera2(camera_index)

        config = csi_camera.create_video_configuration(
            main={
                "size": (width, height),
                "format": "RGB888",
            },
            controls={
                "FrameRate": fps,
            },
        )

        csi_camera.configure(config)
        csi_camera.start()
        time.sleep(1.0)

        csi_camera_started = True
        print("[CSI CAMERA] Started")

        return csi_camera


def generate_csi_camera_frames():
    try:
        import cv2
        camera = init_csi_camera()
    except Exception as exc:
        print(f"[CSI CAMERA] Init error: {exc}")
        return

    while True:
        try:
            with csi_camera_lock:
                frame = camera.capture_array()

            # Korekcja kolorów kamery CSI.
            # Dla ZeroCam/OV5647 czasem konwersja RGB<->BGR odwraca kolory.
            # Ustawienie w .env:
            # CSI_CAMERA_COLOR_MODE=none      - bez konwersji
            # CSI_CAMERA_COLOR_MODE=swap_rb   - zamiana czerwonego z niebieskim
            color_mode = os.getenv("CSI_CAMERA_COLOR_MODE", "none").strip().lower()

            if color_mode in ("swap_rb", "rgb2bgr", "bgr2rgb"):
                frame = cv2.cvtColor(frame, cv2.COLOR_RGB2BGR)

            ok, buffer = cv2.imencode(
                ".jpg",
                frame,
                [int(cv2.IMWRITE_JPEG_QUALITY), 75],
            )

            if not ok:
                continue

            yield (
                b"--frame\r\n"
                b"Content-Type: image/jpeg\r\n\r\n" +
                buffer.tobytes() +
                b"\r\n"
            )

            time.sleep(0.04)

        except GeneratorExit:
            break

        except Exception as exc:
            print(f"[CSI CAMERA] Frame error: {exc}")
            time.sleep(0.2)


@app.route("/camera_feed")
def camera_feed():
    from flask import Response

    return Response(
        generate_csi_camera_frames(),
        mimetype="multipart/x-mixed-replace; boundary=frame",
    )


