autonomy_lock = threading.Lock()
autonomy_stop_event = threading.Event()
autonomy_thread = None
autonomy_audio_process = None

autonomy_state = {
    "running": False,
    "step": "idle",
    "message": "Tryb autonomiczny wyłączony",
    "current_image": None,
    "current_index": 0,
    "total": 3,
    "lang": os.getenv("AUTONOMY_AUDIO_LANG", "pl"),
    "started_at": None,
    "finished_at": None,
}

AUTONOMY_SEQUENCE = [
    ("panorama", "Panorama Racławicka"),
    ("stanczyk", "Stańczyk"),
    ("grunwald", "Bitwa pod Grunwaldem"),
]


def autonomy_env_float(name, default):
    try:
        return float(os.getenv(name, str(default)).replace(",", "."))
    except Exception:
        return float(default)


def autonomy_set_state(**kwargs):
    with autonomy_lock:
        autonomy_state.update(kwargs)


def autonomy_get_motor_controller():
    """
    Szuka istniejącego kontrolera silników w aplikacji.
    Działa z dotychczasowym projektem, niezależnie czy zmienna nazywa się
    motors, motor_controller albo podobnie.
    """
    for name in ("motors", "motor_controller", "motor", "drive"):
        obj = globals().get(name)
        if obj is not None and hasattr(obj, "drive") and hasattr(obj, "stop"):
            return obj

    for obj in list(globals().values()):
        if obj is not None and hasattr(obj, "drive") and hasattr(obj, "stop") and hasattr(obj, "as_dict"):
            return obj

    raise RuntimeError("Nie znaleziono kontrolera silników")


def autonomy_drive(throttle, turn):
    controller = autonomy_get_motor_controller()
    controller.drive(float(throttle), float(turn))


def autonomy_stop_motors():
    try:
        controller = autonomy_get_motor_controller()
        controller.stop()
    except Exception as exc:
        print(f"[AUTONOMY] Motor stop error: {exc}")


def autonomy_stop_audio():
    global autonomy_audio_process

    try:
        if autonomy_audio_process and autonomy_audio_process.poll() is None:
            autonomy_audio_process.terminate()
            autonomy_audio_process.wait(timeout=1.0)
    except Exception:
        try:
            autonomy_audio_process.kill()
        except Exception:
            pass

    autonomy_audio_process = None

    # Zatrzymaj też ewentualny wcześniej dodany mechanizm audio.
    try:
        stop_audio_lang_process()
    except Exception:
        pass

    try:
        stop_audio_process()
    except Exception:
        pass


def autonomy_audio_path(name, lang):
    lang = "en" if str(lang).lower() == "en" else "pl"
    return f"/opt/robot/static/{name}_{lang}.mp3"


def autonomy_play_audio_wait(name, label, lang):
    global autonomy_audio_process

    path = autonomy_audio_path(name, lang)

    if not os.path.exists(path):
        msg = f"Brak pliku audio: {path}"
        print(f"[AUTONOMY] {msg}")
        autonomy_set_state(message=msg)
        return False

    audio_device = os.getenv("AUDIO_DEVICE", "").strip()

    cmd = ["mpg123", "-q"]

    if audio_device:
        cmd += ["-a", audio_device]

    cmd.append(path)

    autonomy_stop_audio()

    print(f"[AUTONOMY] Playing audio: {path}")

    try:
        autonomy_audio_process = subprocess.Popen(
            cmd,
            stdout=subprocess.DEVNULL,
            stderr=subprocess.DEVNULL,
        )

        while autonomy_audio_process.poll() is None:
            if autonomy_stop_event.is_set():
                autonomy_stop_audio()
                return False
            time.sleep(0.1)

        return True

    except Exception as exc:
        msg = f"Błąd odtwarzania audio: {exc}"
        print(f"[AUTONOMY] {msg}")
        autonomy_set_state(message=msg)
        return False


def autonomy_sleep_interruptible(seconds):
    end_time = time.time() + float(seconds)

    while time.time() < end_time:
        if autonomy_stop_event.is_set():
            return False
        time.sleep(0.05)

    return True


def autonomy_run_sequence(lang="pl"):
    lang = "en" if str(lang).lower() == "en" else "pl"

    drive_seconds = autonomy_env_float("AUTONOMY_DRIVE_SECONDS", 4.0)
    speed = autonomy_env_float("AUTONOMY_SPEED", 0.35)
    pause_seconds = autonomy_env_float("AUTONOMY_PAUSE_SECONDS", 0.5)
    rotate_seconds = autonomy_env_float("AUTONOMY_ROTATE_SECONDS", 3.5)
    turn_speed = autonomy_env_float("AUTONOMY_TURN_SPEED", 0.35)

    autonomy_set_state(
        running=True,
        step="start",
        message="Start trybu autonomicznego",
        current_image=None,
        current_index=0,
        total=len(AUTONOMY_SEQUENCE),
        lang=lang,
        started_at=time.time(),
        finished_at=None,
    )

    try:
        for index, (name, label) in enumerate(AUTONOMY_SEQUENCE, start=1):
            if autonomy_stop_event.is_set():
                break

            autonomy_set_state(
                step="drive",
                message=f"Jazda do obrazu {index}: {label}",
                current_image=label,
                current_index=index,
            )

            print(f"[AUTONOMY] Driving to image {index}: {label}")

            start = time.time()
            while time.time() - start < drive_seconds:
                if autonomy_stop_event.is_set():
                    break

                autonomy_drive(speed, 0.0)
                time.sleep(0.08)

            autonomy_stop_motors()

            if autonomy_stop_event.is_set():
                break

            autonomy_set_state(
                step="audio",
                message=f"Odtwarzanie opisu: {label}",
                current_image=label,
                current_index=index,
            )

            autonomy_play_audio_wait(name, label, lang)

            if autonomy_stop_event.is_set():
                break

            autonomy_stop_motors()
            autonomy_sleep_interruptible(pause_seconds)

        if not autonomy_stop_event.is_set():
            autonomy_set_state(
                step="rotate",
                message="Obrót 360 stopni po zakończeniu prezentacji",
                current_image=None,
            )

            print("[AUTONOMY] Final 360 rotation")

            start = time.time()
            while time.time() - start < rotate_seconds:
                if autonomy_stop_event.is_set():
                    break

                autonomy_drive(0.0, turn_speed)
                time.sleep(0.08)

        autonomy_stop_motors()
        autonomy_stop_audio()

        if autonomy_stop_event.is_set():
            autonomy_set_state(
                running=False,
                step="stopped",
                message="Tryb autonomiczny zatrzymany",
                finished_at=time.time(),
            )
        else:
            autonomy_set_state(
                running=False,
                step="finished",
                message="Tryb autonomiczny zakończony",
                finished_at=time.time(),
            )

    except Exception as exc:
        autonomy_stop_motors()
        autonomy_stop_audio()
        autonomy_set_state(
            running=False,
            step="error",
            message=f"Błąd trybu autonomicznego: {exc}",
            finished_at=time.time(),
        )
        print(f"[AUTONOMY] Error: {exc}")


@app.route("/api/autonomy/start", methods=["POST"])
def api_autonomy_start():
    global autonomy_thread

    data = request.get_json(silent=True) or {}
    lang = data.get("lang") or os.getenv("AUTONOMY_AUDIO_LANG", "pl")
    lang = "en" if str(lang).lower() == "en" else "pl"

    with autonomy_lock:
        if autonomy_thread and autonomy_thread.is_alive():
            return jsonify({
                "ok": False,
                "error": "Tryb autonomiczny już działa",
                "state": autonomy_state,
            }), 409

        autonomy_stop_event.clear()

        autonomy_thread = threading.Thread(
            target=autonomy_run_sequence,
            args=(lang,),
            daemon=True,
            name="museum-autonomy-thread",
        )
        autonomy_thread.start()

    return jsonify({
        "ok": True,
        "state": autonomy_state,
    })


@app.route("/api/autonomy/stop", methods=["POST"])
def api_autonomy_stop():
    autonomy_stop_event.set()
    autonomy_stop_motors()
    autonomy_stop_audio()

    autonomy_set_state(
        running=False,
        step="stopping",
        message="Zatrzymywanie trybu autonomicznego",
        finished_at=time.time(),
    )

    return jsonify({
        "ok": True,
        "state": autonomy_state,
    })


@app.route("/api/autonomy/status")
def api_autonomy_status():
    with autonomy_lock:
        return jsonify(dict(autonomy_state))

# === AUTONOMY MUSEUM MODE END ===




