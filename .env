# Skopiuj ten plik jako .env i dostosuj do swojej instalacji.

# Port LIDAR-a USB/COM na Raspberry Pi:
LIDAR_PORT=/dev/ttyUSB0
LIDAR_BAUDRATE=230400

# Panel WWW:
FLASK_HOST=0.0.0.0
FLASK_PORT=5000
FLASK_DEBUG=0

# Bezpieczny stop przed przeszkodą:
ENABLE_OBSTACLE_STOP=1
SAFE_DISTANCE_MM=450

# Kąt, który w fizycznym montażu LIDAR-a oznacza przód robota.
# Dla wielu montażów będzie to 0, ale czasem trzeba ustawić np. 90/180/270.
FRONT_ANGLE_DEG=0
FRONT_SECTOR_DEG=35

# Odwrócenie kierunku poszczególnych silników, jeśli któryś kręci się odwrotnie.
INVERT_LF=0
INVERT_LR=0
INVERT_RF=0
INVERT_RR=0
INVERT_LEFT=0
INVERT_RIGHT=0
SOFTSTART_MS=300
AUDIO_DEVICE=plughw:2,0
AUTONOMY_DRIVE_SECONDS=4
AUTONOMY_SPEED=0.35
AUTONOMY_PAUSE_SECONDS=0.5
AUTONOMY_ROTATE_SECONDS=3.5
AUTONOMY_TURN_SPEED=0.35
AUTONOMY_AUDIO_LANG=pl
CSI_CAMERA_INDEX=0
CSI_CAMERA_WIDTH=640
CSI_CAMERA_HEIGHT=360
CSI_CAMERA_FPS=15
CSI_CAMERA_COLOR_MODE=none
AUTONOMY_OBSTACLE_STOP_MM=700
AUTONOMY_OBSTACLE_RESUME_MM=900
AUTONOMY_OBSTACLE_WAIT_TIMEOUT=0
